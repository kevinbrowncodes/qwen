              "style": {
                "background": "linear-gradient(rgba(0,0,0,0), rgba(0,0,0,0.4))",
                "border_radius": "8px",
                "padding": "8.384px",
                "opacity": "1"
              },
              "children": [
                {
                  "aria_label": "Download",
                  "icon_svg": null,
                  "icon": "appicon-download"
                }
              ]
            }
          ]
        },
        {
          "name": "card (edit result)",
          "selector": ".item-card",
          "src": "[owner image]",
          "box": {
            "x": 201,
            "y": 103,
            "width": 180,
            "height": 180
          },
          "children": [
            {
              "name": "operation-bar (always visible)",
