          "box": {
            "x": 150,
            "y": 15,
            "width": 93,
            "height": 29
          },
          "style": {
            "font_size": "18.864px",
            "color": "#f7f8fc"
          }
        },
        {
          "name": "my-published (icon only)",
          "box": {
            "x": 355,
