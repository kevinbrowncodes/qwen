        "width": 393,
        "height": 59
      },
      "style": {
        "background": "#222222"
      },
      "children": [
        {
          "name": "drawer-toggle",
          "box": {
            "x": 17,
            "y": 19
          },
          "icon_svg": null,
          "icon": "appicon-menu"
        },
        {
          "name": "title",
          "selector": ".header-mobile-title",
