            "padding": "0px 12px",
            "color": "#fafbff"
          }
        },
        {
          "text": "Image",
          "style": {
            "color": "rgba(250,251,255,0.5)"
          }
        },
        {
          "text": "Video"
        },
        {
          "text": "Document"
        },
        {
          "text": "Web Dev"
        },
        {
          "text": "Podcast",
          "notes": "off-screen at x 387"
        }
      ]
    },
    {
      "name": "library-grid (2 columns, 8px gap)",
      "selector": ".masonry-grid",
      "children": [
        {
          "name": "card (16:9)",
          "selector": ".item-card",
          "src": "[owner image]",
          "box": {
            "x": 13,
            "y": 103,
            "width": 180,
            "height": 103
          },
          "children": [
            {
              "name": "operation-bar (always visible)",
              "selector": ".library-item-operation",
