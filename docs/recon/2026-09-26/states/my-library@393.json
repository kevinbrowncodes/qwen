        "x": 17,
        "y": 59,
        "width": 435,
        "height": 32
      },
      "style": {
        "overflow_x": "auto",
        "background": "transparent (no pill track on mobile)"
      },
      "children": [
        {
          "text": "All",
          "active": true,
          "box": {
            "x": 17,
            "y": 59,
            "width": 41,
            "height": 32
