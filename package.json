{
  "name": "qwen-local",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter recon --filter gate --filter stub-generation-server --filter model-server --filter app test",
    "build": "pnpm --filter app build",
    "start": "pnpm --filter app start",
    "recon:login": "pnpm --filter recon login",
    "recon:check": "pnpm --filter recon check",
    "test:integration": "pnpm --filter app test:integration",
    "test:e2e": "pnpm --filter app test:e2e",
    "prepare": "husky",
    "reference:sync": "pnpm --filter recon reference-sync"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "husky": "9.1.7"
  }
}
