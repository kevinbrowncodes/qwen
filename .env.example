# Copy to .env (gitignored) beside compose.yaml and fill in what you use. Never commit .env.

# The app (README → Local dev)
MODEL_BASE_URL=http://qwen-model:4120
MODEL_API_KEY=
HISTORY_FILE=/data/history.json

# spark/fetch-loras.sh: the Civitai API key for the add-ons only Civitai hosts (CHORE_005).
# Mounted read-only into the fetch container and never printed; wins over ~/.config/civitai/token.
CIVITAI_TOKEN=

# recon/run.sh hands (STORY_027, EPIC_006): the Hands app on the Mac. HANDS_API_TOKEN is API_TOKEN from Hands' own
# .env on the Mac; mounted read-only into the recon container and never printed. HANDS_URL defaults to
# http://hands.local, which run.sh resolves on the Spark for the container.
HANDS_URL=
HANDS_API_TOKEN=
