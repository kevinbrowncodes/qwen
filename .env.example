# Copy to .env (gitignored) beside compose.yaml and fill in what you use. Never commit .env.

# The app (README → Running the UI). On the app Mac, tools/deploy/app.sh writes these into ~/qwen-app/.env itself.
MODEL_BASE_URL=
MODEL_API_KEY=
HISTORY_FILE=/data/history.json

# tools/gate/remote.sh and the pre-push hook (STORY_034): on a Mac without Docker, the gate runs on this Mac's Docker
# over ssh. An ssh destination (a host alias from ~/.ssh/config works). Left empty here: machine names live only in .env.
GATE_HOST=

# tools/deploy/model.sh (STORY_036): the Mac that runs the model server natively (Metal), as an ssh destination.
# The model server's own key lives only on that Mac (~/qwen-model/.env); copy it into MODEL_API_KEY above to bench
# from here (spark/bench-loras.sh), without printing it.
MODEL_HOST=

# tools/deploy/app.sh (STORY_037): the Mac that runs the app in Docker (it joins PATHS' proxy for qwen.local).
APP_HOST=
# tools/deploy/migrate-from-spark.sh (STORY_037, run once): the DGX Spark the history and images are moved from.
SPARK_HOST=

# spark/fetch-loras.sh: the Civitai API key for the add-ons only Civitai hosts (CHORE_005).
# Mounted read-only into the fetch container and never printed; wins over ~/.config/civitai/token.
CIVITAI_TOKEN=

# recon/run.sh hands (STORY_027, EPIC_006): the Hands app on the Mac. HANDS_API_TOKEN is API_TOKEN from Hands' own
# .env on the Mac; mounted read-only into the recon container and never printed. HANDS_URL defaults to
# http://hands.local, which run.sh resolves on the Spark for the container.
HANDS_URL=
HANDS_API_TOKEN=
# recon/run.sh hands <date> routine (STORY_028): the owner's chat on the reference that the committed routine opens;
# fills the routine file's {{HANDS_CHAT_URL}} at upload time so no chat id is in git. Never printed.
HANDS_CHAT_URL=
